{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *graph/*.md) cd \"$CLAUDE_PROJECT_DIR\" && python3 scripts/graph.py validate \"$f\" ;; esac",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 scripts/graph.py validate 2>&1 | tail -1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
